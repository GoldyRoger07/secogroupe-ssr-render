{
    "version": 2,
    "name": "secogroupe-ssr",
    "rewrites": [
        {
        "source": "/AutoDiscover/autodiscover.xml",
        "destination": "/404"
        },
        {
        "source": "/autodiscover.xml",
        "destination": "/404"
        },
        {
            "source": "/(.*)",
            "destination": "/api"
        }
    ],
    "functions":{
        "api/index.js": {
            "includeFiles": "dist/secogroupe-ssr/**"
        }
    }
}